<!-- Cap ClickHouse's internal *_log tables. Without this they grow unbounded
     (the demo's high query volume + self-instrumentation once ballooned
     text_log/query_log/trace_log to ~12GB). 2-day TTL keeps recent diagnostics
     while bounding disk. -->
<clickhouse>
    <query_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></query_log>
    <query_thread_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></query_thread_log>
    <trace_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></trace_log>
    <part_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></part_log>
    <text_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></text_log>
    <metric_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></metric_log>
    <asynchronous_metric_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></asynchronous_metric_log>
    <processors_profile_log><ttl>event_date + INTERVAL 2 DAY DELETE</ttl></processors_profile_log>
</clickhouse>
